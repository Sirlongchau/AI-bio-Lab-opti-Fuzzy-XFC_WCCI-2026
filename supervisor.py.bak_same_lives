from risk_field import RiskField
from test_controller_fuzzy import FuzzyController
from Casadi_mpc import MPCController
from angular_profile import AngularProfile


class Supervisor:
    """
    Fuzzy-first supervisor.

    MPC is used only for respawn or extreme no-corridor high-risk states.
    The fuzzy controller remains the primary competition controller.
    """

    def __init__(self):
        self.controllers = {
            "fuzzy": FuzzyController(),
            "mpc": MPCController(),
            "sacrifice": FuzzyController(),
        }
        self.mode = "fuzzy"
        self.MPCfail = 0
        self.risk_field = None
        self.angular_profile = AngularProfile()
        self._map_size = None

        self.R_extreme = 0.65
        self.tau_extreme = 0.45

    def _ensure(self, map_size):
        if self.risk_field is None or self._map_size != map_size:
            self._map_size = map_size
            self.risk_field = RiskField(map_size=map_size)

    def select_mode(self, ship_state, game_state):
        self._ensure(game_state.map_size)

        if getattr(ship_state, "respawn_time_left", 0.0) > 0:
            self.mode = "mpc"
            return

        risks = self.risk_field.compute_all(
            ship_state.position,
            ship_state.velocity,
            game_state.asteroids,
        )
        R_global = self.risk_field.aggregate(risks)
        tau_min = self.risk_field.min_tau(risks)

        profile = self.angular_profile.build(risks)
        corridors = self.angular_profile.extract_corridors(profile)
        no_corridor = len(corridors) == 0

        if no_corridor and tau_min < self.tau_extreme and R_global > self.R_extreme:
            self.mode = "mpc"
        else:
            self.mode = "fuzzy"

    def compute(self, ship_state, game_state):
        self.select_mode(ship_state, game_state)
        controller = self.controllers[self.mode]
        output = controller.compute(ship_state, game_state)

        if getattr(ship_state, "respawn_time_left", 0.0) > 0:
            self.MPCfail = 0

        if self.mode == "fuzzy":
            return output

        if self.mode == "mpc" and output is not None:
            if not output.feasible:
                self.MPCfail += 1
                self.mode = "fuzzy" if self.MPCfail < 10 else "sacrifice"
                return self.controllers[self.mode].compute(ship_state, game_state)

            self.MPCfail = 0
            return output.thrust, output.turn_rate, False, False

        return 0.0, 0.0, False, False
