"""
Fuzzy_MPC_Controller.py
=======================
Stable tactical controller for Kessler/XFC.

Behavior goals:
1. Avoid asteroids first.
2. Avoid map-edge run-off.
3. Search/rotate toward targets when nothing is in front.
4. Keep behavior identical across all lives.
"""

from __future__ import annotations

import math
from typing import Any, Dict, List, Optional, Tuple


THRUST_MIN = -480.0
THRUST_MAX = 480.0
TURN_MIN = -180.0
TURN_MAX = 180.0

SHIP_RADIUS = 18.0
BULLET_SPEED = 800.0

CRUISE_THRUST = 285.0
SEARCH_THRUST = 165.0
EVADE_THRUST = 460.0
TURN_ONLY_THRUST = 25.0
EDGE_REVERSE_THRUST = -190.0

MAX_COMFORT_SPEED = 215.0
MAX_EDGE_SPEED = 145.0

TURN_KP = 5.85
TURN_KD = 1.35
TURN_FILTER = 0.10
THRUST_FILTER = 0.14

EDGE_MARGIN = 285.0
EDGE_PANIC = 155.0
EDGE_LOOKAHEAD = 1.45
EDGE_WEIGHT = 2.75

AVOID_RADIUS = 285.0
PANIC_SURFACE = 115.0
TTC_DANGER = 1.75
CLOSEST_DANGER = 165.0
AVOID_HORIZON = 2.25
AVOID_WEIGHT = 4.20

FRONT_CONE_DEG = 60.0
FIRE_CONE_DEG = 12.0
FIRE_CONE_CLOSE_DEG = 18.0
FIRE_CONE_PANIC_DEG = 8.0
FIRE_CLOSE_SURFACE = 420.0
FIRE_HAZARD_BLOCK = 0.88
FIRE_EDGE_BLOCK = 0.82
SEARCH_MIN_TURN = 115.0


def _clamp(x: float, lo: float, hi: float) -> float:
    return max(lo, min(hi, x))


def _get(obj: Any, name: str, default: Any = None) -> Any:
    if isinstance(obj, dict):
        return obj.get(name, default)
    return getattr(obj, name, default)


def _angle_diff(target: float, current: float) -> float:
    return (target - current + 180.0) % 360.0 - 180.0


def _bearing(dx: float, dy: float) -> float:
    return math.degrees(math.atan2(dy, dx))


def _unit(deg: float) -> Tuple[float, float]:
    rad = math.radians(deg)
    return math.cos(rad), math.sin(rad)


def _toric_delta(tx: float, ty: float, sx: float, sy: float, map_w: float, map_h: float) -> Tuple[float, float]:
    dx = tx - sx
    dy = ty - sy

    if dx > map_w * 0.5:
        dx -= map_w
    elif dx < -map_w * 0.5:
        dx += map_w

    if dy > map_h * 0.5:
        dy -= map_h
    elif dy < -map_h * 0.5:
        dy += map_h

    return dx, dy


def _asteroid_radius(ast: Any) -> float:
    radius = _get(ast, "radius", None)
    if radius is not None:
        try:
            return max(6.0, float(radius))
        except Exception:
            pass

    size = _get(ast, "size", 2)
    try:
        size = float(size)
    except Exception:
        size = 2.0

    if size <= 5.0:
        return 10.0 + 8.0 * size

    return max(8.0, size)


class Controller:
    def __init__(self):
        self.prev_turn = 0.0
        self.prev_thrust = 0.0
        self.prev_error = 0.0
        self.search_dir = 1.0
        self.debug_last: Dict[str, Any] = {}

    @property
    def name(self) -> str:
        return "stable_tactical_controller"

    def actions(self, ship_state, game_state):
        if self._is_respawning(ship_state):
            self.prev_turn = 0.0
            self.prev_thrust = 0.0
            self.prev_error = 0.0
            return 0.0, 0.0, False, False

        state = self._read_state(ship_state, game_state)
        target = self._select_target(state)
        hazard = self._most_dangerous_asteroid(state)
        edge = self._edge_status(state)

        desired_heading, mode = self._choose_heading(state, target, hazard, edge)

        thrust, turn_rate = self._control_to_heading(state, desired_heading, mode, edge, hazard)

        fire = self._fire_decision(state, target, hazard, edge)
        mine = False

        self.debug_last = {
            "mode": mode,
            "desired_heading": desired_heading,
            "heading": state["heading"],
            "speed": state["speed"],
            "target": None if target is None else {
                "bearing": target["bearing"],
                "aim_bearing": target["aim_bearing"],
                "aim_error": _angle_diff(target["aim_bearing"], state["heading"]),
                "score": target["score"],
            },
            "hazard": None if hazard is None else {
                "danger": hazard["danger"],
                "surface": hazard["surface"],
                "ttc": hazard["ttc"],
                "bearing": hazard["bearing"],
            },
            "edge": edge,
            "thrust": thrust,
            "turn_rate": turn_rate,
            "fire": fire,
        }

        return thrust, turn_rate, fire, mine

    def _read_state(self, ship_state: Any, game_state: Any) -> Dict[str, Any]:
        map_size = _get(game_state, "map_size", (1000, 800))
        map_w, map_h = float(map_size[0]), float(map_size[1])

        pos = _get(ship_state, "position", (map_w * 0.5, map_h * 0.5))
        vel = _get(ship_state, "velocity", (0.0, 0.0))

        x, y = float(pos[0]), float(pos[1])
        vx, vy = float(vel[0]), float(vel[1])

        heading = float(_get(ship_state, "heading", _get(ship_state, "angle", 0.0)))
        speed = float(_get(ship_state, "speed", math.hypot(vx, vy)))

        asteroids = list(_get(game_state, "asteroids", []) or [])

        return {
            "ship_state": ship_state,
            "game_state": game_state,
            "map_w": map_w,
            "map_h": map_h,
            "x": x,
            "y": y,
            "vx": vx,
            "vy": vy,
            "heading": heading,
            "speed": speed,
            "asteroids": asteroids,
        }

    def _is_respawning(self, ship_state: Any) -> bool:
        if bool(_get(ship_state, "is_respawning", False)):
            return True
        return float(_get(ship_state, "respawn_time_left", 0.0) or 0.0) > 0.0

    def _can_fire(self, ship_state: Any) -> bool:
        if self._is_respawning(ship_state):
            return False
        cooldown = _get(ship_state, "fire_cooldown", None)
        if cooldown is not None:
            try:
                if float(cooldown) > 0.0:
                    return False
            except Exception:
                pass
        return True

    def _asteroid_info(self, state: Dict[str, Any], ast: Any) -> Optional[Dict[str, float]]:
        pos = _get(ast, "position", None)
        if pos is None:
            return None

        vel = _get(ast, "velocity", (0.0, 0.0))
        ax, ay = float(pos[0]), float(pos[1])
        avx, avy = float(vel[0]), float(vel[1])

        dx, dy = _toric_delta(ax, ay, state["x"], state["y"], state["map_w"], state["map_h"])
        dist = max(1e-6, math.hypot(dx, dy))

        radius = _asteroid_radius(ast)
        surface = dist - radius - SHIP_RADIUS

        rvx = avx - state["vx"]
        rvy = avy - state["vy"]

        closing = -((dx * rvx + dy * rvy) / dist)

        if rvx * rvx + rvy * rvy > 1e-6:
            tca = _clamp(-(dx * rvx + dy * rvy) / (rvx * rvx + rvy * rvy), 0.0, AVOID_HORIZON)
        else:
            tca = AVOID_HORIZON

        closest = math.hypot(dx + rvx * tca, dy + rvy * tca) - radius - SHIP_RADIUS

        if closing > 1e-6:
            ttc = max(0.0, surface / closing)
        else:
            ttc = 99.0

        return {
            "ast": ast,
            "dx": dx,
            "dy": dy,
            "dist": dist,
            "surface": surface,
            "radius": radius,
            "avx": avx,
            "avy": avy,
            "rvx": rvx,
            "rvy": rvy,
            "closing": closing,
            "tca": tca,
            "closest": closest,
            "ttc": ttc,
            "bearing": _bearing(dx, dy),
        }

    def _most_dangerous_asteroid(self, state: Dict[str, Any]) -> Optional[Dict[str, float]]:
        best = None

        for ast in state["asteroids"]:
            info = self._asteroid_info(state, ast)
            if info is None:
                continue

            surface_term = _clamp((AVOID_RADIUS - info["surface"]) / AVOID_RADIUS, 0.0, 1.0)
            closest_term = _clamp((CLOSEST_DANGER - info["closest"]) / CLOSEST_DANGER, 0.0, 1.0)
            ttc_term = _clamp((TTC_DANGER - info["ttc"]) / TTC_DANGER, 0.0, 1.0)

            danger = 0.60 * surface_term + 0.95 * closest_term + 1.05 * ttc_term

            if info["surface"] < PANIC_SURFACE:
                danger = max(danger, 1.0)

            danger = _clamp(danger, 0.0, 1.0)

            if danger <= 0.03:
                continue

            info["danger"] = danger

            if best is None or info["danger"] > best["danger"]:
                best = info

        return best

    def _intercept_bearing(self, state: Dict[str, Any], info: Dict[str, float]) -> Tuple[float, float]:
        rx, ry = info["dx"], info["dy"]
        vx = info["avx"] - state["vx"]
        vy = info["avy"] - state["vy"]

        a = vx * vx + vy * vy - BULLET_SPEED * BULLET_SPEED
        b = 2.0 * (rx * vx + ry * vy)
        c = rx * rx + ry * ry

        t = None

        if abs(a) < 1e-6:
            if abs(b) > 1e-6:
                candidate = -c / b
                if candidate > 0.0:
                    t = candidate
        else:
            disc = b * b - 4.0 * a * c
            if disc >= 0.0:
                s = math.sqrt(disc)
                roots = [(-b - s) / (2.0 * a), (-b + s) / (2.0 * a)]
                roots = [r for r in roots if r > 0.0]
                if roots:
                    t = min(roots)

        if t is None:
            t = _clamp(info["dist"] / BULLET_SPEED, 0.0, 1.25)

        t = _clamp(t, 0.0, 1.50)

        aim_x = rx + vx * t
        aim_y = ry + vy * t

        return _bearing(aim_x, aim_y), t

    def _select_target(self, state: Dict[str, Any]) -> Optional[Dict[str, float]]:
        best = None

        for ast in state["asteroids"]:
            info = self._asteroid_info(state, ast)
            if info is None:
                continue

            aim_bearing, t_hit = self._intercept_bearing(state, info)
            aim_error = abs(_angle_diff(aim_bearing, state["heading"]))

            closeness = _clamp((650.0 - info["surface"]) / 650.0, 0.0, 1.0)
            threat = _clamp((AVOID_RADIUS - info["closest"]) / AVOID_RADIUS, 0.0, 1.0)
            aim_quality = 1.0 - min(1.0, aim_error / 180.0)
            size_quality = _clamp(info["radius"] / 45.0, 0.0, 1.0)

            score = (
                1.90 * closeness
                + 1.25 * threat
                + 3.25 * aim_quality
                + 0.35 * size_quality
                - 0.35 * t_hit
            )

            candidate = dict(info)
            candidate["aim_bearing"] = aim_bearing
            candidate["t_hit"] = t_hit
            candidate["aim_error"] = aim_error
            candidate["score"] = score

            if best is None or score > best["score"]:
                best = candidate

        return best

    def _edge_status(self, state: Dict[str, Any]) -> Dict[str, float]:
        x, y = state["x"], state["y"]
        vx, vy = state["vx"], state["vy"]
        w, h = state["map_w"], state["map_h"]

        fx = x + vx * EDGE_LOOKAHEAD
        fy = y + vy * EDGE_LOOKAHEAD

        left = min(x, fx)
        right = w - max(x, fx)
        bottom = min(y, fy)
        top = h - max(y, fy)

        edge_dist = min(left, right, bottom, top)
        danger = _clamp((EDGE_MARGIN - edge_dist) / EDGE_MARGIN, 0.0, 1.0)

        if edge_dist < EDGE_PANIC:
            danger = 1.0

        center_dx = w * 0.5 - x
        center_dy = h * 0.5 - y
        center_bearing = _bearing(center_dx, center_dy)

        center_len = max(1e-6, math.hypot(center_dx, center_dy))
        inward_v = (vx * center_dx + vy * center_dy) / center_len
        outward_speed = max(0.0, -inward_v)

        return {
            "dist": edge_dist,
            "danger": danger,
            "center_bearing": center_bearing,
            "outward_speed": outward_speed,
        }

    def _candidate_headings(self, state: Dict[str, Any], target, hazard, edge) -> List[float]:
        h = state["heading"]
        candidates = [
            h,
            h + 45.0,
            h - 45.0,
            h + 90.0,
            h - 90.0,
            edge["center_bearing"],
        ]

        if target is not None:
            candidates.extend([
                target["aim_bearing"],
                target["bearing"],
                target["aim_bearing"] + 18.0,
                target["aim_bearing"] - 18.0,
            ])

        if hazard is not None:
            away = _bearing(-hazard["dx"], -hazard["dy"])
            candidates.extend([
                away,
                away + 35.0,
                away - 35.0,
                away + 70.0,
                away - 70.0,
                away + 110.0,
                away - 110.0,
            ])

        if edge["danger"] > 0.0:
            c = edge["center_bearing"]
            candidates.extend([c, c + 25.0, c - 25.0, c + 55.0, c - 55.0])

        return [c % 360.0 for c in candidates]

    def _score_heading(self, state: Dict[str, Any], heading: float, target, hazard, edge) -> float:
        ux, uy = _unit(heading)

        desired_speed = 190.0
        if edge["danger"] > 0.0:
            desired_speed = 155.0
        if hazard is not None and hazard["danger"] > 0.25:
            desired_speed = 220.0

        cand_vx = 0.45 * state["vx"] + 0.55 * desired_speed * ux
        cand_vy = 0.45 * state["vy"] + 0.55 * desired_speed * uy

        min_clearance = 9999.0
        collision_penalty = 0.0

        for ast in state["asteroids"]:
            info = self._asteroid_info(state, ast)
            if info is None:
                continue

            for t in (0.45, 0.90, 1.35, 1.80, 2.25):
                rel_x = info["dx"] + info["avx"] * t - cand_vx * t
                rel_y = info["dy"] + info["avy"] * t - cand_vy * t
                clearance = math.hypot(rel_x, rel_y) - info["radius"] - SHIP_RADIUS

                min_clearance = min(min_clearance, clearance)

                if clearance < 0.0:
                    collision_penalty += 12.0
                elif clearance < PANIC_SURFACE:
                    collision_penalty += (PANIC_SURFACE - clearance) / PANIC_SURFACE * 4.0

        score = 0.025 * min_clearance - collision_penalty

        for t in (0.60, 1.20, 1.80):
            px = state["x"] + cand_vx * t
            py = state["y"] + cand_vy * t
            edge_clearance = min(px, state["map_w"] - px, py, state["map_h"] - py)
            if edge_clearance < EDGE_MARGIN:
                score -= EDGE_WEIGHT * (EDGE_MARGIN - edge_clearance) / EDGE_MARGIN

        if target is not None:
            score += 3.50 * (1.0 - abs(_angle_diff(target["aim_bearing"], heading)) / 180.0)

        if hazard is not None:
            away = _bearing(-hazard["dx"], -hazard["dy"])
            score += AVOID_WEIGHT * hazard["danger"] * (1.0 - abs(_angle_diff(away, heading)) / 180.0)

        if edge["danger"] > 0.0:
            score += EDGE_WEIGHT * edge["danger"] * (1.0 - abs(_angle_diff(edge["center_bearing"], heading)) / 180.0)

        score -= 0.20 * abs(_angle_diff(heading, state["heading"])) / 180.0

        return score

    def _choose_heading(self, state: Dict[str, Any], target, hazard, edge) -> Tuple[float, str]:
        candidates = self._candidate_headings(state, target, hazard, edge)

        best_heading = state["heading"]
        best_score = -999999.0

        for h in candidates:
            score = self._score_heading(state, h, target, hazard, edge)
            if score > best_score:
                best_heading = h
                best_score = score

        # Hard safety still wins.
        if edge["danger"] >= 0.80:
            return best_heading, "edge_escape"

        if hazard is not None and hazard["danger"] >= 0.62:
            return best_heading, "asteroid_evade"

        # Strong target lock when not in hard danger.
        if target is not None:
            aim_error = abs(_angle_diff(target["aim_bearing"], state["heading"]))

            mild_hazard = hazard is not None and hazard["danger"] >= 0.35
            mild_edge = edge["danger"] >= 0.35

            # If moderate danger exists, use scored compromise heading.
            if mild_hazard or mild_edge:
                if aim_error <= FRONT_CONE_DEG:
                    return best_heading, "attack"
                return best_heading, "search_to_target"

            # If safe, directly pursue intercept bearing instead of over-balancing avoidance.
            if aim_error <= FRONT_CONE_DEG:
                return target["aim_bearing"], "attack"

            return target["aim_bearing"], "search_to_target"

        return (state["heading"] + self.search_dir * 90.0) % 360.0, "scan"

    def _control_to_heading(self, state: Dict[str, Any], desired: float, mode: str, edge, hazard) -> Tuple[float, float]:
        error = _angle_diff(desired, state["heading"])
        d_error = error - self.prev_error
        self.prev_error = error

        turn = TURN_KP * error + TURN_KD * d_error
        turn = _clamp(turn, TURN_MIN, TURN_MAX)

        abs_error = abs(error)
        speed = state["speed"]

        if mode == "edge_escape":
            if abs_error < 70.0:
                thrust = EVADE_THRUST
            else:
                thrust = TURN_ONLY_THRUST

            if edge["outward_speed"] > 120.0 and abs_error > 95.0:
                thrust = EDGE_REVERSE_THRUST

            if speed > MAX_EDGE_SPEED and abs_error > 80.0:
                thrust = min(thrust, 0.0)

        elif mode == "asteroid_evade":
            if abs_error < 75.0:
                thrust = EVADE_THRUST
            elif abs_error < 125.0:
                thrust = 80.0
            else:
                thrust = 0.0

        elif mode == "search_to_target":
            thrust = SEARCH_THRUST

            if abs(error) < 95.0:
                thrust = max(thrust, 210.0)

            if abs(turn) < SEARCH_MIN_TURN:
                sign = 1.0 if error >= 0.0 else -1.0
                turn = sign * SEARCH_MIN_TURN

        elif mode == "attack":
            if abs_error < 15.0:
                thrust = CRUISE_THRUST
            elif abs_error < 55.0:
                thrust = 210.0
            else:
                thrust = 110.0

        else:
            thrust = SEARCH_THRUST
            if abs(turn) < SEARCH_MIN_TURN:
                turn = self.search_dir * SEARCH_MIN_TURN

        if speed > MAX_COMFORT_SPEED and mode not in ("edge_escape", "asteroid_evade"):
            thrust = min(thrust, 35.0)

        turn = TURN_FILTER * self.prev_turn + (1.0 - TURN_FILTER) * turn
        thrust = THRUST_FILTER * self.prev_thrust + (1.0 - THRUST_FILTER) * thrust

        self.prev_turn = _clamp(turn, TURN_MIN, TURN_MAX)
        self.prev_thrust = _clamp(thrust, THRUST_MIN, THRUST_MAX)

        return self.prev_thrust, self.prev_turn

    def _fire_decision(self, state: Dict[str, Any], target, hazard, edge) -> bool:
        if target is None:
            return False

        if not self._can_fire(state["ship_state"]):
            return False

        # Only suppress fire in true emergency states.
        # Do not stop shooting just because risk is moderate.
        if edge["danger"] > FIRE_EDGE_BLOCK:
            return False

        if hazard is not None and hazard["danger"] > FIRE_HAZARD_BLOCK:
            return False

        aim_error = abs(_angle_diff(target["aim_bearing"], state["heading"]))

        # Dynamic fire cone:
        # tight when unsafe, wide when close/safe.
        fire_cone = FIRE_CONE_DEG

        if target["surface"] < FIRE_CLOSE_SURFACE:
            fire_cone = FIRE_CONE_CLOSE_DEG

        if hazard is not None and hazard["danger"] > 0.65:
            fire_cone = FIRE_CONE_PANIC_DEG

        if edge["danger"] > 0.55:
            fire_cone = FIRE_CONE_PANIC_DEG

        return aim_error <= fire_cone

    def explain(self) -> Dict[str, Any]:
        return dict(self.debug_last)


